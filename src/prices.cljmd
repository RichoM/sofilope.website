(require '[clojure.string :as str])
(require 'ssgr)
(require 'fs)

(def scroll-margin-top "62px")

(def colors ["FFAC81"
             "FF928B"
             "FEC3A6"
             "EFE9AE"
             "CDEAC0"])

(defn nth-color [idx]
  (nth colors (mod idx (count colors))))

(declare gallery gallery-item lightbox)

(defn card 
  [id title text]
  [:div.card ;.mb-3
   {:id id :style (str "scroll-margin-top: " scroll-margin-top ";")}
   [:div.row.g-0
    [:div.col-md
     (let [color (nth-color (rand-int 10))]
       (lightbox
        [:img
         {:src (str "https://placehold.co/400x500/" color "/3c3430") :alt "..."
          :style "height: 100%; width: 100%; object-fit: cover;"}]
        :img (str "https://placehold.co/1400x1500/" color "/3c3430")))
     [:div.position-absolute.top-0.start-0.m-4 ;.text-center.w-100.p-3
      [:h1 title]
      ]]
    [:div.col-md-7
     [:div.card-body
      ;[:h2.card-title title]
      [:div.card-text
       (ssgr/markdown text)]
      [:p.card-text
       (gallery
        {:style "column-width: 10vh; column-count: 4;"}
        (->> (range 12)
             (map (fn [_]
                    (let [w 200 ;(+ 200 (rand-int 500))
                          h 150 ; (+ w -150 (rand-int 200))
                          color (nth-color (rand-int 10))
                          img (str "https://placehold.co/"
                                   w "x"
                                   h "/"
                                   color "/3c3430")
                          fullscreen (str "https://placehold.co/"
                                          (+ 1000 w) "x"
                                          (+ 1000 h) "/"
                                          color "/3c3430")]
                      (gallery-item
                       (lightbox [:img {:src img :loading "lazy"}]
                                 :img fullscreen)))))
             (doall)))]]]]])

[:div
 {:data-bs-spy "scroll"
  :data-bs-target "#navbarNavDropdown"
  :data-bs-root-margin "0px 0px -40%"
  :data-bs-smooth-scroll "true"
  :tabindex "0"}
 (->> (fs/list-dir "src/prices")
      (remove fs/directory?)
      (sort)
      (map (fn [file]
             (let [[_ name _] (str/split (fs/file-name file) #"\.")
                   id (str/trim name)
                   title (id->title id)
                   text (slurp file)]
               (card id title text))))
      (interpose [:p]))]
