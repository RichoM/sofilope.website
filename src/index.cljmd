(require 'ssgr)
(require '[clojure.string :as str])
(declare carousel carousel-slide lightbox)

(def colors ["FFAC81"
             "FF928B"
             "FEC3A6"
             "EFE9AE"
             "CDEAC0"])

(defn nth-color [idx]
  (nth colors (mod idx (count colors))))

[:div.container
 (apply carousel
        (->> (range 50)
             (map (fn [idx]
                    (carousel-slide
                     :img (str "https://placehold.co/900x450/" (nth-color idx) "/3c3430")
                     :fullscreen-img (str "https://placehold.co/2900x2450/" (nth-color idx) "/3c3430"))))))]

[:div.px-1.w-100.bg-light
 [:div.gallery
  (->> (range 50)
       (map (fn [idx]
              [:div.gallery-item
               (let [w (+ 200 (rand-int 500))
                     h (+ w -150 (rand-int 200))
                     img (str "https://placehold.co/"
                              w "x"
                              h "/"
                              (nth-color idx) "/3c3430")
                     fullscreen (str "https://placehold.co/"
                                     (+ 1000 w) "x"
                                     (+ 1000 h) "/"
                                     (nth-color idx) "/3c3430")]
                 (lightbox [:img {:src img :loading "lazy"}]
                           :img fullscreen))]))
       (doall))]]
